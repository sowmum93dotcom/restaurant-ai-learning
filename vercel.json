{
  "rewrites": [
    {
      "source": "/api/customer/identity",
      "destination": "/api/public-config?resource=customer-identity"
    },
    {
      "source": "/api/customer/understanding",
      "destination": "/api/public-config?resource=customer-understanding"
    },
    {
      "source": "/api/customer/intentions",
      "destination": "/api/public-config?resource=customer-intentions"
    },
    {
      "source": "/api/customer/possibilities/saved",
      "destination": "/api/public-config?resource=customer-saved-possibilities"
    },
    {
      "source": "/api/customer/participation",
      "destination": "/api/public-config?resource=customer-participation"
    },
    {
      "source": "/api/customer/preferences",
      "destination": "/api/public-config?resource=customer-preferences"
    },
    {
      "source": "/api/customer/privacy-controls",
      "destination": "/api/public-config?resource=customer-privacy-controls"
    },
    {
      "source": "/api/customer/work/:campaignId/feedback",
      "destination": "/api/customer/work/:campaignId/participation?interaction=feedback"
    },
    {
      "source": "/api/customer/preparation",
      "destination": "/api/public-config?resource=customer-preparation"
    },
    {
      "source": "/api/customer/checkout",
      "destination": "/api/public-config?resource=customer-checkout"
    },
    {
      "source": "/api/admin/business-applications",
      "destination": "/api/businesses?resource=admin-applications"
    },
    {
      "source": "/api/admin/business-applications/:businessId",
      "destination": "/api/businesses?resource=admin-applications&businessId=:businessId"
    }
  ]
}
