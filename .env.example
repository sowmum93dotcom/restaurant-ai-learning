# Copy this file to .env and adjust as needed.

# SQLite file database — zero setup, works out of the box.
# To move to a hosted Postgres database later, change this to a
# postgres:// connection string and update prisma/schema.prisma's
# datasource provider from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Used to sign session cookies for login. Any long random string works
# for local development — generate a real one before deploying.
SESSION_SECRET="dev-only-secret-change-me"

# Optional. When set, search uses a real Claude API call to understand
# queries (lib/aiSearch.ts) instead of keyword matching. Get a key at
# https://console.anthropic.com/ — leave this unset to keep using the
# keyword fallback (e.g. in this sandbox, which has no key configured).
ANTHROPIC_API_KEY=
