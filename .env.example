# Copy this file to .env and adjust as needed.

# PostgreSQL connection string. For local development, point this at a
# local Postgres instance. For production, use your hosted database's
# connection string (e.g. from Supabase: Project Settings -> Database ->
# Connection string -> URI, using the "Transaction pooler" port 6543 for
# serverless hosting like Vercel).
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/verra"

# Optional. When set, search uses a real Claude API call to understand
# queries (lib/aiSearch.ts) instead of keyword matching. Get a key at
# https://console.anthropic.com/ — leave this unset to keep using the
# keyword fallback (e.g. in this sandbox, which has no key configured).
ANTHROPIC_API_KEY=
