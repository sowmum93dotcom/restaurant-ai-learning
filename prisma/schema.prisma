// Prisma schema for Verra.
//
// Uses PostgreSQL — a hosted database in production (e.g. Supabase or
// Neon), a local Postgres instance for development. Point DATABASE_URL
// at whichever one you're using; no schema changes needed either way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         String // "owner" | "admin"
  createdAt    DateTime       @default(now())
  sessions     Session[]
  claims       ListingClaim[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id                String         @id @default(cuid())
  category          String // "restaurant" | "retail"
  name              String
  neighborhood      String // references a fixed neighborhood id (see lib/neighborhoods.ts)
  x                 Float // simulated map coordinate, same scheme as the earlier demo
  y                 Float
  hoursOpen         String // "HH:MM"
  hoursClose        String // "HH:MM"
  priceTier         Int // 1 ($) to 3 ($$$)
  types             String // comma-separated, e.g. "italian,pizza"
  tags              String // comma-separated, e.g. "vegan,gluten-free"
  verified          Boolean        @default(false)
  verificationLevel String         @default("unverified") // unverified | self_attested | confirmed
  source            String         @default("seed") // seed | owner | admin
  rating            Float          @default(0)
  highlight         String         @default("")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  claims            ListingClaim[]

  // Search filters by category and verification status on every request
  // (app/api/search/route.ts, app/api/admin/listings/route.ts).
  @@index([category])
  @@index([verified])
}

model ListingClaim {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("approved") // pending | approved | rejected
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([listingId])
  @@index([userId])
}
